# Backend port (uvicorn bind)
BACKEND_PORT=8000

# Frontend port (Next.js dev server)
FRONTEND_PORT=3000

# Deployment port for the single service
PORT=3000

# Backend base URL used by Next.js proxy rewrites
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Default provider configuration (optional — each has a hardcoded fallback)
# ---------------------------------------------------------------------------
# Users can always override any value in the UI; their choices persist in
# localStorage and take precedence over both env vars and hardcoded defaults.
# ---------------------------------------------------------------------------

DEFAULT_CHAT_PROVIDER=nvidia-nim
DEFAULT_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_CHAT_MODEL=openai/gpt-oss-20b
DEFAULT_CHAT_API_KEY=

DEFAULT_EMBEDDING_PROVIDER=nvidia-nim
DEFAULT_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
DEFAULT_EMBEDDING_API_KEY=
