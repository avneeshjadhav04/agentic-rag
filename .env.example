# Backend port (uvicorn bind)
BACKEND_PORT=8000

# Frontend port (Next.js dev server)
FRONTEND_PORT=3000

# Deployment port for the single service
PORT=3000

# Backend base URL used by Next.js proxy rewrites
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Default provider configuration (optional — each has a hardcoded fallback)
# ---------------------------------------------------------------------------
# Users can always override any value in the UI; their choices persist in
# localStorage and take precedence over both env vars and hardcoded defaults.
# ---------------------------------------------------------------------------

DEFAULT_GENERATION_PROVIDER=nvidia-nim
DEFAULT_GENERATION_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_GENERATION_MODEL=openai/gpt-oss-20b
DEFAULT_GENERATION_API_KEY=

DEFAULT_EVALUATION_PROVIDER=nvidia-nim
DEFAULT_EVALUATION_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_EVALUATION_MODEL=openai/gpt-oss-20b
DEFAULT_EVALUATION_API_KEY=

DEFAULT_EMBEDDING_PROVIDER=nvidia-nim
DEFAULT_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
DEFAULT_EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Evaluation results directory (optional — defaults to backend/.deepeval/)
# ---------------------------------------------------------------------------
# Where the eval runner persists eval_<timestamp>.json files and the
# /api/eval/results endpoint reads the latest from.
# ---------------------------------------------------------------------------
DEEPEVAL_RESULTS_FOLDER=backend/.deepeval

# ---------------------------------------------------------------------------
# DeepEval telemetry opt-out (optional — defaults to true via Dockerfile ENV)
# ---------------------------------------------------------------------------
# Disables DeepEval's outbound telemetry (PostHog, Sentry, ipify) which can
# cause connection errors in restricted cloud environments. Set to "false"
# to re-enable if desired. The Dockerfile sets this to "true" by default;
# a platform-level env var overrides the Dockerfile value.
# ---------------------------------------------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=true

# ---------------------------------------------------------------------------
# Eval concurrency (optional — defaults to 4)
# ---------------------------------------------------------------------------
# Maximum number of goldens scored in parallel during a Run Evals run.
# Higher values speed up evals but increase concurrent LLM calls to the
# evaluation provider (judge calls) and generation/embedding providers
# (RAG graph invocations). Set to 1 for fully sequential evals.
# ---------------------------------------------------------------------------
EVAL_MAX_CONCURRENCY=4
