# Backend port (used inside the container)
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Default provider configuration
# ---------------------------------------------------------------------------
# Every value is optional.  When a DEFAULT_* env var is not set a hardcoded
# fallback is used instead.  Users can always override any value in the UI –
# their choices persist in localStorage and take precedence over both env
# vars and hardcoded defaults.
# ---------------------------------------------------------------------------

DEFAULT_CHAT_PROVIDER=nvidia-nim
DEFAULT_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_CHAT_MODEL=openai/gpt-oss-20b
DEFAULT_CHAT_API_KEY=

DEFAULT_EMBEDDING_PROVIDER=nvidia-nim
DEFAULT_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
DEFAULT_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
DEFAULT_EMBEDDING_API_KEY=
